<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Cámara para la traducción en vivo (permiso de ejecución) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Almacenamiento para leer imágenes de la galería -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.SignTranslator"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LivePreviewActivity"
            android:exported="false"
            android:label="@string/live_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".StaticAnalysisActivity"
            android:exported="false"
            android:label="@string/static_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".TipsActivity"
            android:exported="false"
            android:label="@string/btn_tips"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".CreditsActivity"
            android:exported="false"
            android:label="@string/btn_credits"
            android:parentActivityName=".MainActivity" />

        <!-- Necesario para pasar la foto de la cámara nativa a la app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
